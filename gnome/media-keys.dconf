[/]
calculator=['<Super>q']
control-center=['<Control>comma']
custom-keybindings=['/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom0/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom4/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom6/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom9/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom10/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom2/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom14/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom5/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom8/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom3/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom1/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom7/']
logout=@as []
magnifier-zoom-in=['<Super>plus']
magnifier-zoom-out=['<Super>minus']
mic-mute=['AudioMicMute']
search=@as []
volume-down=['AudioLowerVolume']
volume-mute=['AudioMute']
volume-up=['AudioRaiseVolume']

[custom-keybindings/custom0]
binding='<Super>t'
command='gnome-terminal --maximize'
name='Terminal'

[custom-keybindings/custom1]
binding='<Super>f'
command='bash -c "gnome-terminal -e ~/SourceApps/gnome/file-picker.sh"'
name='File-Picker'

[custom-keybindings/custom10]
command="gnome-terminal --maximize -- bash -ic '\nfile=$(\n  find . -type f |\n  fzf \\\n    --style=full \\\n   --preview \"cat {}\" \\\n    --bind \"focus:transform-header:file --brief {}\"\n)\n\n[ -n \"$file\" ] && xdg-open \"$file\"\n\nexec bash\n'"
name='fzf search'

[custom-keybindings/custom14]
binding='<Super>e'
command='nautilus -w'
name='Launch File Manager'

[custom-keybindings/custom2]
binding='<Super>x'
command='secrets'
name='Passwords'

[custom-keybindings/custom3]
binding='Print'
command='gradia --screenshot=INTERACTIVE'
name='Gradia'

[custom-keybindings/custom4]
binding='<Super>m'
command='gnome-terminal --maximize -e nvim'
name='Launch Vim'

[custom-keybindings/custom5]
binding='<Super>i'
command='bash -c "$HOME/SourceApps/gnome/gnome-manmenu.sh"'
name='Manpages'

[custom-keybindings/custom6]
binding='<Control><Alt>Delete'
command='gnome-system-monitor'
name='Resources'

[custom-keybindings/custom7]
binding='<Shift><Super>e'
command='bash -c "gnome-terminal -e ~/SourceApps/gnome/command-run.sh"'
name='Command Run'

[custom-keybindings/custom8]
binding='<Super>b'
command='bash -c "$HOME/SourceApps/gnome/gnome-browser-launch.sh"'
name='Browser Search'

[custom-keybindings/custom9]
binding='<Shift><Super>b'
command='bash -c "$HOME/apps/tor-browser/Browser/start-tor-browser"'
name='Launch Tor'
